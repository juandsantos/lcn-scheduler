LCN_EMAIL=tu_correo@example.com
LCN_PASSWORD=tu_contrasena

# Cuantas clases quieres intentar agendar por ejecucion.
LCN_MAX_CLASSES=99

# Valores que aparecen en la plataforma.
LCN_SEDE=Sede Aves Maria (Sabaneta)
LCN_TIPO_CLASE=Clase

# Horarios de clase que debe intentar, separados por coma.
LCN_PREFERRED_TIMES=6:00 AM,7:30 AM,9:00 AM,10:30 AM,12:00 PM,1:30 PM,3:00 PM,4:30 PM,6:00 PM,7:00 PM

# Horarios especiales cuando la fecha objetivo es sabado.
LCN_SATURDAY_TIMES=9:45 AM,11:15 AM,1:30 PM,3:00 PM

# Para probar visualmente en tu PC: false. Para servidor/GitHub Actions: true.
LCN_HEADLESS=false

# Ventana diaria de ejecucion en hora de Colombia.
LCN_RUN_START=06:00
LCN_RUN_END=19:10

# Cada cuanto reintenta si lo corres localmente en modo continuo.
LCN_POLL_SECONDS=600
